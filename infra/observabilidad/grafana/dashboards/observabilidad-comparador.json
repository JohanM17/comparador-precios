    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 17
      },
      "id": 30,
      "panels": [],
      "title": "Reportes y alertas",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Tasa de reportes procesados agrupada por estado. La instrumentacion normaliza la etiqueta estado a aceptado, dudoso u otro para mantener baja la cardinalidad.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "reqps"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "id": 6,
      "options": {
        "legend": {
          "calcs": [],
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "sum by (estado) (rate(precios_reportes_total{service_name=\"comparador-precios-backend\"}[$__rate_interval]))",
          "legendFormat": "{{estado}}",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Reportes por estado",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Estado de las alertas del comparador expuestas por la serie ALERTS. El panel queda preparado y solo mostrara datos cuando T-122 cargue las reglas de alerta en el motor de Prometheus o Mimir.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "inspect": false
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "id": 7,
      "options": {
        "cellHeight": "sm",
        "footer": {
          "countRows": false,
          "fields": "",
          "reducer": [
            "sum"
          ],
          "show": false
        },
        "showHeader": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "ALERTS{alertname=~\"Comparador.*\"}",
          "format": "table",
          "instant": true,
          "legendFormat": "__auto",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Estado de alertas",
      "type": "table"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 25
      },
      "id": 40,
      "panels": [],
      "title": "SLO y presupuesto de error",
      "type": "row"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "SLI de comparacion en ventana movil de 7 dias: peticiones con latencia menor o igual a 2 s y sin respuesta 5xx sobre el total de comparaciones. Meta 99 %. Zona roja por debajo de 0,99. Como el histograma por defecto no tiene bucket de 2000 ms, la consulta interpola entre los buckets de 1000 ms y 2500 ms; T-126 debe validar los limites reales.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 2,
          "mappings": [],
          "max": 1,
          "min": 0.9,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.99
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 26
      },
      "id": 8,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "(sum(rate(http_server_duration_milliseconds_bucket{service_name=\"comparador-precios-backend\", http_route=\"/v1/productos/{id}/comparacion\", le=\"1000\", http_status_code!~\"5..\"}[7d])) + (2000 - 1000) / (2500 - 1000) * (sum(rate(http_server_duration_milliseconds_bucket{service_name=\"comparador-precios-backend\", http_route=\"/v1/productos/{id}/comparacion\", le=\"2500\", http_status_code!~\"5..\"}[7d])) - sum(rate(http_server_duration_milliseconds_bucket{service_name=\"comparador-precios-backend\", http_route=\"/v1/productos/{id}/comparacion\", le=\"1000\", http_status_code!~\"5..\"}[7d])))) / sum(rate(http_server_duration_milliseconds_count{service_name=\"comparador-precios-backend\", http_route=\"/v1/productos/{id}/comparacion\"}[7d]))",
          "instant": true,
          "legendFormat": "SLI 7d",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "SLI de comparacion (7 dias)",
      "type": "gauge"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Fraccion del presupuesto de error del 1 % consumida en 7 dias, usando la misma estimacion interpolada del SLI. 100 % significa presupuesto agotado; por encima de 100 % el SLO esta incumplido.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "decimals": 1,
          "mappings": [],
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 26
      },
      "id": 9,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto",
        "wideLayout": true
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "editorMode": "code",
          "expr": "clamp_min(1 - ((sum(rate(http_server_duration_milliseconds_bucket{service_name=\"comparador-precios-backend\", http_route=\"/v1/productos/{id}/comparacion\", le=\"1000\", http_status_code!~\"5..\"}[7d])) + (2000 - 1000) / (2500 - 1000) * (sum(rate(http_server_duration_milliseconds_bucket{service_name=\"comparador-precios-backend\", http_route=\"/v1/productos/{id}/comparacion\", le=\"2500\", http_status_code!~\"5..\"}[7d])) - sum(rate(http_server_duration_milliseconds_bucket{service_name=\"comparador-precios-backend\", http_route=\"/v1/productos/{id}/comparacion\", le=\"1000\", http_status_code!~\"5..\"}[7d])))) / sum(rate(http_server_duration_milliseconds_count{service_name=\"comparador-precios-backend\", http_route=\"/v1/productos/{id}/comparacion\"}[7d]))), 0) / 0.01",
          "instant": true,
          "legendFormat": "presupuesto consumido",
          "range": false,
          "refId": "A"
        }
      ],
      "title": "Presupuesto de error consumido (7 dias)",
      "type": "stat"
    },
    {
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 26
      },
      "id": 11,
      "options": {
        "code": {
          "language": "plaintext",
          "showLineNumbers": false,
          "showMiniMap": false
